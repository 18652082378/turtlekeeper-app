# Copy this file to .env on your server, then fill real values.
SMS_PROVIDER=aliyun-pnvs
SMS_MOCK=false

# Aliyun RAM AccessKey. Do not commit real secrets to GitHub.
ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret

# Aliyun Phone Number Verification Service SMS authentication values.
ALIYUN_SMS_SIGN_NAME=your_sms_sign_name
ALIYUN_SMS_TEMPLATE_CODE=100001

# Gift template 100001 uses ${code} and ${min}.
ALIYUN_SMS_TEMPLATE_PARAM_KEY=code
ALIYUN_SMS_TEMPLATE_MINUTES=5
ALIYUN_SMS_CODE_LENGTH=6
ALIYUN_SMS_VALID_TIME=300
ALIYUN_SMS_COUNTRY_CODE=86

# Keep 127.0.0.1 when using Nginx reverse proxy.
HOST=127.0.0.1
PORT=8787

# Optional MySQL storage. Leave MYSQL_HOST empty to keep using app-data.json.
# Before enabling it, run `npm run migrate:mysql` after setting these values.
# MYSQL_HOST=your-rds-internal-host
# MYSQL_PORT=3306
# MYSQL_DATABASE=turtlekeeper
# MYSQL_USER=turtlekeeper_api
# MYSQL_PASSWORD=replace-with-a-strong-password
# MYSQL_URL=mysql://...  # Optional alternative; do not set both forms.

# Optional Alibaba Cloud OSS media delivery. When all fields below are set,
# new uploads are copied to OSS and return an OSS/CDN URL. Keep these secrets
# only in server/.env; never commit them or paste them into chat.
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET=turtlekeeper-media-hz2026
# OSS_ACCESS_KEY_ID=your_ram_access_key_id
# OSS_ACCESS_KEY_SECRET=your_ram_access_key_secret
# Set this to a CDN hostname later (for example https://media.example.com).
# Until CDN is configured, use the bucket's public endpoint.
# OSS_PUBLIC_BASE_URL=https://turtlekeeper-media-hz2026.oss-cn-hangzhou.aliyuncs.com

# Platform content-review administrator and automatic backup retention.
ADMIN_PHONE=your_admin_phone
BACKUP_RETENTION_DAYS=30

# iOS remote push notifications (APNs). Create an Apple Push Notifications .p8 key
# in Apple Developer, upload it to the server outside this project, and set its path.
# Never commit the .p8 key or paste it into GitHub.
APNS_TEAM_ID=your_apple_team_id
APNS_KEY_ID=your_apns_key_id
APNS_BUNDLE_ID=com.turtlekeeper.app
APNS_KEY_PATH=/www/turtlekeeper-app/server/AuthKey_your_key_id.p8
# Optional alternative to APNS_KEY_PATH: base64 text of the full .p8 file.
# APNS_KEY_BASE64=
# TestFlight/App Store must use api.push.apple.com. Only local development can use sandbox.
APNS_HOST=api.push.apple.com
