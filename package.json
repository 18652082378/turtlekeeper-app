{
  "name": "turtlekeeper-ios-app",
  "version": "1.1.8",
  "private": true,
  "description": "ShellNote iOS cloud build package",
  "scripts": {
    "start": "node server/server.js",
    "build": "node scripts/build-web.js",
    "cap:sync:android": "npm run build && npx cap sync android",
    "cap:open:android": "npm run cap:sync:android && npx cap open android",
    "test:backup-restore": "node scripts/test-backup-restore.js",
    "test:api-workflows": "node scripts/test-api-workflows.js",
    "test:team": "node scripts/test-team-space.js",
    "test:team-breeding": "node scripts/test-team-breeding.cjs",
    "test:team-visibility": "node scripts/test-team-visibility.cjs",
    "test:team-ui": "node scripts/test-team-ui.cjs",
    "test:mysql-records": "node scripts/test-mysql-records.js",
    "test:mysql-record-api": "node scripts/test-mysql-record-api.js",
    "test:data-reliability": "node scripts/test-data-reliability.cjs",
    "test:reliability-guards": "node scripts/test-reliability-guards.cjs",
    "test:release119-compat": "node scripts/test-data-reliability.cjs --release --compat --hotfix",
    "test:ui": "node scripts/test-ui-consistency.cjs",
    "test:ui-interactions": "node scripts/test-ui-experience.cjs",
    "test:client-mutations": "node scripts/test-client-mutation-races.cjs",
    "test:media-safety": "node scripts/test-media-attribute-safety.cjs",
    "test:postrelease-server": "node scripts/test-postrelease-server-audit.cjs --workflows && node scripts/test-postrelease-growth-delete.cjs && node scripts/test-postrelease-registration-race.cjs",
    "test:navigation": "node scripts/test-navigation-lifecycle.cjs && node scripts/test-navigation-freshness.cjs",
    "migrate:mysql-records": "node scripts/migrate-mysql-records.js",
    "migrate:mysql": "node scripts/migrate-json-to-mysql.js",
    "migrate:oss-media": "node scripts/migrate-local-media-to-oss.js",
    "migrate:ios-video": "node scripts/migrate-legacy-videos-for-ios.js",
    "backup:mysql-cutover": "node scripts/backup-before-mysql-cutover.js",
    "verify:backup": "node scripts/restore-server-backup.js",
    "cap:add:ios": "npm run build && npx cap add ios",
    "cap:sync:ios": "npm run build && npx cap sync ios && node scripts/configure-ios-local-plugins.js",
    "cap:open:ios": "npm run build && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.4.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "8.4.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "8.4.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.1",
    "ali-oss": "^6.23.0",
    "alipay-sdk": "4.14.0",
    "mysql2": "^3.14.3",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
