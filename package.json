{
  "name": "turtlekeeper-ios-app",
  "version": "1.0.3",
  "private": true,
  "description": "ShellNote iOS cloud build package",
  "scripts": {
    "start": "node server/server.js",
    "build": "node scripts/build-web.js",
    "test:backup-restore": "node scripts/test-backup-restore.js",
    "test:api-workflows": "node scripts/test-api-workflows.js",
    "migrate:mysql": "node scripts/migrate-json-to-mysql.js",
    "migrate:oss-media": "node scripts/migrate-local-media-to-oss.js",
    "migrate:ios-video": "node scripts/migrate-legacy-videos-for-ios.js",
    "backup:mysql-cutover": "node scripts/backup-before-mysql-cutover.js",
    "verify:backup": "node scripts/restore-server-backup.js",
    "cap:add:ios": "npm run build && npx cap add ios",
    "cap:sync:ios": "npm run build && npx cap sync ios && node scripts/configure-ios-local-plugins.js",
    "cap:open:ios": "npm run build && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "8.4.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "8.4.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.1",
    "ali-oss": "^6.23.0",
    "mysql2": "^3.14.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
