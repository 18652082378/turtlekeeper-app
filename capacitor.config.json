{
  "appId": "com.turtlekeeper.app",
  "appName": "龟友手账",
  "webDir": "www",
  "bundledWebRuntime": false,
  "android": {
    "includePlugins": ["@capacitor/app", "@capacitor/network"]
  },
  "ios": {
    "scheme": "TurtleKeeper",
    "handleApplicationNotifications": true
  },
  "plugins": {
    "Keyboard": {
      "resize": "native"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
